# Public URL of this site (optional on Vercel: the production URL is used automatically)
NEXT_PUBLIC_SITE_URL=
# Serene Booking deployment that serves /booking on this site (Next.js Multi-Zones), no trailing slash,
# e.g. https://serene-booking.vercel.app — that app must be built with basePath "/booking" (its default).
# When set, every booking button opens /booking/… on this domain. When empty, they open WhatsApp instead.
BOOKING_ORIGIN=
# Serene Investors deployment that serves /serene-investors on this site, no trailing slash,
# e.g. https://serene-investors.vercel.app — built with basePath "/serene-investors" (its default).
# When set, the Investors section shows an "Open Serene Investors" button that opens it in the same tab.
INVESTORS_ORIGIN=
# Optional override for booking links (normally derived from BOOKING_ORIGIN).
NEXT_PUBLIC_BOOKING_URL=
# Set to "true" only on the real public domain once facts are signed off; otherwise pages are noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false
